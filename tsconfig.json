{
	// src/helpers/*.ts is the source of truth; `npm run build` compiles it to
	// dist/, which is COMMITTED. That is not laziness — this package is consumed
	// as a git dependency, so there is no publish step to compile in, and the
	// alternative (a `prepare` script) would make every consumer install run a
	// TypeScript build. Node also refuses to strip types inside node_modules
	// (ERR_UNSUPPORTED_NODE_MODULES_TYPE_STRIPPING), so consumers running plain
	// `node script.ts` against their own server code have to reach real .js
	// here. `npm test` fails if dist/ is stale, which is what keeps it honest.
	"compilerOptions": {
		"target": "es2022",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["es2023", "dom"],
		"strict": true,
		"declaration": true,
		"removeComments": false,
		"rootDir": "src/helpers",
		"outDir": "dist",
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		// One helper imports another, and `npm test` runs the .ts sources
		// directly under Node — which resolves an extension literally and would
		// not find a `./text.js` that only exists after a build. So the source
		// says `./text.ts`, and tsc rewrites it to `./text.js` on the way into
		// dist/, where the extension is true again.
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true
	},
	"include": ["src/helpers/**/*.ts"]
}
