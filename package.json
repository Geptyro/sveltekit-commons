{
	"name": "sveltekit-commons",
	"version": "0.3.0",
	"description": "Design-token contract, Svelte 5 primitives and dependency-free helpers shared across SvelteKit sites",
	"type": "module",
	"license": "MIT",
	"svelte": "./src/index.js",
	"exports": {
		".": {
			"types": "./src/index.d.ts",
			"svelte": "./src/index.js",
			"default": "./src/index.js"
		},
		"./tokens.css": "./src/styles/tokens.css",
		"./base.css": "./src/styles/base.css",
		"./place": {
			"types": "./dist/place.d.ts",
			"default": "./dist/place.js"
		},
		"./paging": {
			"types": "./dist/paging.d.ts",
			"default": "./dist/paging.js"
		},
		"./cache": {
			"types": "./dist/cache.d.ts",
			"default": "./dist/cache.js"
		},
		"./text": {
			"types": "./dist/text.d.ts",
			"default": "./dist/text.js"
		},
		"./time": {
			"types": "./dist/time.d.ts",
			"default": "./dist/time.js"
		},
		"./sitemap": {
			"types": "./dist/sitemap.d.ts",
			"default": "./dist/sitemap.js"
		}
	},
	"files": [
		"src",
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check:dist": "tsc -p tsconfig.json --outDir .dist-check && diff -r dist .dist-check && rm -rf .dist-check",
		"test": "npm run build && node --test \"tests/**/*.test.ts\""
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"typescript": "^6.0.3"
	}
}
